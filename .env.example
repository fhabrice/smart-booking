# ============================================================================
#  Smart Booking RDC 🇨🇩 — Variables d'environnement
#  Copier ce fichier vers `.env.local` pour le développement.
#  Sur Netlify : Site settings → Environment variables (mêmes noms).
# ============================================================================

# ----------------------------------------------------------------------------
#  BASE DE DONNÉES SUPABASE (OBLIGATOIRE — le site lit TOUTES ses données
#  dans la base ; il n'existe plus aucune donnée de démo / de secours)
#
#  💡 Développement SANS compte Supabase : `npm run dev:local` démarre un
#     PostgreSQL embarqué + une API REST locale compatible Supabase (voir
#     README → « Développement local »). Au premier lancement, ce mode crée un
#     `.env.local` y pointant — les valeurs ci-dessous ne servent alors à rien.
# ----------------------------------------------------------------------------

# URL du projet Supabase (Projet → Settings → API → Project URL)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# (NEXT_PUBLIC_SUPABASE_URL est aussi accepté en repli pour SUPABASE_URL)
# NEXT_PUBLIC_SUPABASE_URL=

# Clé « service_role » (Projet → Settings → API → service_role — SECRET)
# ⚠️  Reste exclusivement côté serveur (Route Handlers /api/*) : elle contourne
#     les politiques RLS. Ne JAMAIS la préfixer NEXT_PUBLIC_ ni la publier.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ----------------------------------------------------------------------------
#  INSTALLATION DE LA BASE (facultatif — uniquement pour `npm run db:setup`)
#
#  Chaîne de connexion PostgreSQL du projet Supabase
#  (Project Settings → Database → Connection string → « Session pooler »).
#  ⚠️  Ce n'est PAS la clé service_role : c'est le mot de passe de la base.
#  À définir dans le terminal le temps de l'installation, pas dans Netlify.
# ----------------------------------------------------------------------------
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<MOTDEPASSE>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ----------------------------------------------------------------------------
#  ADMINISTRATION
# ----------------------------------------------------------------------------

# Code secret d'accès à l'espace /admin.
# Vérifié CÔTÉ SERVEUR par /api/admin/auth — jamais exposé dans le bundle navigateur.
# Valeur de secours si la variable est absente : admin243 → à changer impérativement en production.
ADMIN_ACCESS_CODE=changez-moi-code-fort

# ----------------------------------------------------------------------------
#  DIVERS
# ----------------------------------------------------------------------------

# Taux indicatif USD → franc congolais (affichage + équivalents retraits)
NEXT_PUBLIC_USD_TO_FC_RATE=2850

# ----------------------------------------------------------------------------
#  INSTALLATION DE LA BASE (une seule fois, dans Supabase Studio → SQL Editor) :
#    1. supabase-schema.sql   → tables, RLS, données de référence
#    2. seed-catalog.sql      → catalogue initial réel (6 prestataires + 20 prestations)
#    (migration-paiement-direct.sql : uniquement pour une base créée AVANT
#     l'ajout du paiement direct — ces colonnes sont déjà dans le schéma)
# ----------------------------------------------------------------------------
