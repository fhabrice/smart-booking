# ============================================================================
#  Smart Booking RDC 🇨🇩 — Variables d'environnement
#  Copier ce fichier vers `.env.local` pour le développement.
#  Sur Netlify : Site settings → Environment variables (mêmes noms).
#
#  ⚠️  Ne JAMAIS publier NEXT_PUBLIC_SUPABASE_SERVICE_ROLE_KEY.
# ============================================================================

# URL du projet Supabase (obligatoire pour activer la base de données)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé publique "anon" (obligatoire — utilisable côté navigateur grâce aux RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clé "service_role" (optionnelle — uniquement côté serveur / Route Handlers)
SUPABASE_SERVICE_ROLE_KEY=

# Code secret d'accès à l'espace /admin.
# Vérifié CÔTÉ SERVEUR par /api/admin/auth — jamais exposé dans le bundle navigateur.
# Aucun bouton « démo » ni code par défaut n'est affiché à l'écran.
# Valeur de secours si la variable est absente : admin243 → à changer impérativement en production.
ADMIN_ACCESS_CODE=changez-moi-code-fort

# Taux indicatif USD → franc congolais
NEXT_PUBLIC_USD_TO_FC_RATE=2850
